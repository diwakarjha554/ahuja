# ─── Core ────────────────────────────────────────────────────────────────
# Postgres. Local dev example; include &uselibpqcompat=true for hosted Postgres
# that presents a self-signed CA (Aiven etc.). See README.
DATABASE_URL="postgresql://ahuja:ahuja@127.0.0.1:5432/ahuja_pa_world?schema=public"
# openssl rand -base64 32
AUTH_SECRET=""
# The real origin in production (never localhost): drives emails, cookies, SEO.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
# Boot fails fast on a missing secret when set. Production must set it.
REQUIRE_BACKEND=""

# ─── First admin (used only by db:bootstrap to create the first login) ──────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# ─── Payments (Razorpay) ────────────────────────────────────────────────────
# With these blank, online payment is refused before any order is written; the
# store still runs on Cash on Delivery.
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""
# The webhook 401s everything until this is set.
PAYMENT_WEBHOOK_SECRET=""

# ─── Shipping (Shiprocket, optional) ────────────────────────────────────────
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION=""
SHIPROCKET_WEBHOOK_TOKEN=""

# ─── Mail (first configured route wins: Brevo API, Brevo SMTP, then SMTP) ────
BREVO_API_KEY=""
BREVO_SMTP_LOGIN=""
BREVO_SMTP_KEY=""
BREVO_FROM="Ahuja PA World <no-reply@ahujapaworld.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Ahuja PA World <ahujapaworld@gmail.com>"
MAIL_REPLY_TO="support@ahujapaworld.com"
